# Supabase — client + server (public, usadas no browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (APENAS server-side, p/ admin e ingestão do widget)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend (email transaccional) — opcional. Se vazio, notificações de handoff
# não são enviadas. Gere a key em https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nerva <nerva@seu-dominio.com>"

# Cron — autoriza o endpoint /api/cron/followup. Gere um valor aleatório
# forte (ex: openssl rand -hex 32). Em Vercel, setar a var e o cron usa
# automaticamente via Authorization header.
CRON_SECRET=

# Stripe — billing. Crie conta em https://stripe.com, pegue as keys em
# Developers → API keys. Crie dois produtos recorrentes (Starter e Pro)
# e cole os Price IDs (price_xxx) abaixo. Pro webhook local, use:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# o comando imprime o STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# WhatsApp Business API (Meta). Configure o webhook no Meta Business
# Suite → WhatsApp → Configuration apontando pra
# https://seu-dominio.com/api/whatsapp/webhook e cole aqui o mesmo
# verify token que você colocar lá. Per-bot: phone_number_id e
# access_token são configurados no form de cada bot.
WHATSAPP_VERIFY_TOKEN=

# Google OAuth (Calendar integration)
# 1. https://console.cloud.google.com → New project
# 2. APIs & Services → Enable "Google Calendar API"
# 3. OAuth consent screen → External, fill basics
# 4. Credentials → Create OAuth Client ID → Web application
# 5. Authorized redirect URIs:
#    - https://seu-dominio/api/google/callback
#    - http://localhost:3000/api/google/callback (dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
